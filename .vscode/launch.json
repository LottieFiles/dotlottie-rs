{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Debug Example (Software)",
      "cargo": {
        "args": [
          "build",
          "--manifest-path",
          "${workspaceFolder}/dotlottie-rs/Cargo.toml",
          "--example",
          "${input:swExample}"
        ]
      },
      "cwd": "${workspaceFolder}"
    },
  ],
  "inputs": [
    {
      "id": "swExample",
      "type": "pickString",
      "description": "Select the example to debug",
      "options": [
        "player",
        "slots",
        "external_assets",
        "state_machine"
      ],
      "default": "player"
    }
  ]
}
