    {
      "type": "PointerMove",
      "stateName": "dragging",
      "actions": [
        { "type": "SetNumeric", "inputName": "scrub", "value": "$path_t" },
        { "type": "Multiply", "inputName": "scrub", "value": 100 },
        { "type": "SetProgress", "value": "$scrub" }
      ]
    }
  ],
  "inputs": [
    { "type": "Numeric", "name": "path_t", "value": 0 },
    { "type": "Numeric", "name": "scrub", "value": 0 },
    { "type": "Event", "name": "grab" },
    { "type": "Event", "name": "release" }
  ]
