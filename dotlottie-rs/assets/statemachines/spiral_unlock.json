{
  "initial": "idle",
  "states": [
    {
      "type": "PlaybackState",
      "name": "idle",
      "animation": "",
      "segment": "locked",
      "autoplay": false,
      "transitions": [
        {
          "type": "Transition",
          "toState": "dragging",
          "guards": [{ "type": "Event", "inputName": "grab" }]
        }
      ]
    },
    {
      "type": "PlaybackState",
      "name": "dragging",
      "animation": "",
      "segment": "locked",
      "autoplay": false,
      "transitions": [
        {
          "type": "Tweened",
          "toState": "unlocked",
          "duration": 0.4,
          "easing": [0.42, 0, 0.58, 1],
          "guards": [
            { "type": "Event", "inputName": "release" },
            {
              "type": "Numeric",
              "conditionType": "GreaterThanOrEqual",
              "inputName": "path_t",
              "compareTo": 0.95
            }
          ]
        },
        {
          "type": "Tweened",
          "toState": "idle",
          "duration": 0.35,
          "easing": [0.25, 0.1, 0.25, 1],
          "guards": [{ "type": "Event", "inputName": "release" }]
        }
      ]
    },
    {
      "type": "PlaybackState",
      "name": "unlocked",
      "animation": "",
      "segment": "unlocked",
      "autoplay": true,
      "loop": false,
      "transitions": []
    }
  ],
  "interactions": [
    {
      "type": "DragAndDrop",
      "layerName": "Ellipse 1",
      "//": "pathLayerName -> path is extracted during load time.",
      "pathLayerName": "Spiral Path",
      "progressInput": "path_t",
      "onGrab": [{ "type": "Fire", "inputName": "grab" }],
      "onDrop": [{ "type": "Fire", "inputName": "release" }]
